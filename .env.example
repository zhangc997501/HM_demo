# ============================================================
# 环境变量模板：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 大模型（阿里云百炼，OpenAI 兼容协议）----------
API_KEY=
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_MODEL=qwen-plus
VL_MODEL=qwen-vl-max

# ---------- JWT ----------
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=agentprojecrdb

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 业务 ----------
MAX_INTERVIEW_ROUNDS=20

# ---------- 阿里云 OSS（可选：留空则 OSS_ENABLED=False）----------
# 用途：用户上传的简历 PDF 与 JD 图片存到 OSS，数据库只存 URL
# AccessKey 获取：阿里云控制台 → RAM 访问控制 → 创建仅有 OSS 权限的子账号（不要用主账号 AK）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Endpoint 与 Bucket 所在地域一致，如北京：oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=
# 绑定了自定义域名/CDN 才填，留空用默认域名
OSS_PUBLIC_BASE_URL=
