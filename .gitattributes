# 默认：由 git 判断是否文本文件，文本在工作区与仓库内统一 LF
* text=auto eol=lf

# 源码强制按文本处理，仓库内统一 LF
*.py    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf

# 二进制：不做任何换行/差异处理
*.wav   binary
*.pcm   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
